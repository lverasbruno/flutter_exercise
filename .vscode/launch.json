{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Main App",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Main App (Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "Main App (Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "Main App (Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    },
    {
      "name": "Widgetbook",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/widgetbook",
      "program": "${workspaceFolder}/widgetbook/lib/main.dart"
    },
    {
      "name": "Run All Tests",
      "request": "launch",
      "type": "dart",
      "program": "test/",
      "codeLens": {
        "for": ["run-test", "run-test-file"]
      }
    }
  ]
}

